# app_window.py
msgid "Systemd User Task Manager"
msgstr "Systemd ユーザータスクマネージャー"

msgid "Follow system settings"
msgstr "システム設定に従う"

msgid "Light theme"
msgstr "ライトテーマ"

msgid "Dark theme"
msgstr "ダークテーマ"

msgid "Theme"
msgstr "テーマ"

msgid "Refresh"
msgstr "更新"

msgid "Open unit files folder"
msgstr "ユニットファイルのフォルダを開く"

msgid "About Systemd User Task Manager"
msgstr "Systemd ユーザータスクマネージャーについて"

msgid "Next: {}\nLast: {} ({})"
msgstr "次回: {}\n前回: {} ({})"

msgid "Delete task?"
msgstr "タスクを削除しますか？"

msgid "Task \"{}\" will be deleted. This action cannot be undone."
msgstr "タスク「{}」を削除します。この操作は取り消せません。"

msgid "Cancel"
msgstr "キャンセル"

msgid "Delete"
msgstr "削除"

# task_dialog.py
msgid "Task Settings"
msgstr "タスク設定"

msgid "Task ID"
msgstr "タスク ID"

msgid "Command to execute"
msgstr "実行するコマンド"

msgid "Select file"
msgstr "ファイルを選択"

msgid "Delay after boot (min)"
msgstr "起動後の遅延（分）"

msgid "Execute missed tasks on next boot (Persistent)"
msgstr "実行できなかったタスクを次回起動時に実行する (Persistent)"

msgid "Custom"
msgstr "カスタム"

msgid "At Startup"
msgstr "起動時"

msgid "Hourly"
msgstr "毎時"

msgid "Daily"
msgstr "毎日"

msgid "Weekly"
msgstr "毎週"

msgid "Monthly"
msgstr "毎月"

msgid "Schedule (Preset)"
msgstr "スケジュール（プリセット）"

msgid "Schedule (OnCalendar)"
msgstr "スケジュール（OnCalendar形式）"

msgid "Save"
msgstr "保存"

msgid "Save Anyway"
msgstr "そのまま保存"

msgid "Validation Unavailable"
msgstr "検証機能を利用できません"

msgid "Invalid Schedule"
msgstr "不正なスケジュール"

msgid "The schedule format seems invalid. Do you want to save it anyway?"
msgstr "スケジュールの形式が正しくないようです。このまま保存しますか？"

# manager.py
msgid "Please enter a schedule"
msgstr "スケジュールを入力してください"

msgid "Run {} minutes after system boot"
msgstr "システム起動の {} 分後に実行"

msgid "Validation unavailable: 'systemd-analyze' command not found."
msgstr "検証機能を利用できません: 'systemd-analyze' コマンドが見つかりません。"

msgid "Validation unavailable: Flatpak permission 'talk-name=org.freedesktop.Flatpak' is required to use host tools."
msgstr "検証機能を利用できません: ホスト側のツールを使用するために、Flatpak の権限 'talk-name=org.freedesktop.Flatpak' が必要です。"