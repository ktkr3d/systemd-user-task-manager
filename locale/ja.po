msgid ""
"Enter systemd time format (OnCalendar).\n"
"\n"
"Examples:\n"
"- hourly, daily, weekly, monthly\n"
"- 12:00 (Every day at 12:00)\n"
"- Mon 09:00 (Every Monday at 09:00)\n"
"- *:00/15 (Every 15 minutes)\n"
"- *-*-01 00:00 (1st of every month)"
msgstr ""
"systemdの時刻指定形式（OnCalendar）を入力します。\n"
"\n"
"主な例:\n"
"・hourly, daily, weekly, monthly\n"
"・12:00 (毎日12:00)\n"
"・Mon 09:00 (毎週月曜 09:00)\n"
"・*:00/15 (15分おき)\n"
"・*-*-01 00:00 (毎月1日)"

msgid "Select command file"
msgstr "コマンドファイルを選択"

msgid "Follow system settings"
msgstr "システム設定に従う"

msgid "Light theme"
msgstr "ライトテーマ"

msgid "Dark theme"
msgstr "ダークテーマ"

msgid "Theme"
msgstr "テーマ"

